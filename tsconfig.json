{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-agent/types/**/*.ts",
    ".next-agent/dev/types/**/*.ts",
    ".next-3460/types/**/*.ts",
    ".next-3460/dev/types/**/*.ts",
    ".next-part22/types/**/*.ts",
    ".next-part22/dev/types/**/*.ts",
    ".next-part23/types/**/*.ts",
    ".next-part23/dev/types/**/*.ts",
    ".next-part24/types/**/*.ts",
    ".next-part24/dev/types/**/*.ts",
    ".next-part25/types/**/*.ts",
    ".next-part25/dev/types/**/*.ts",
    ".next-part31/types/**/*.ts",
    ".next-part31/dev/types/**/*.ts",
    ".next-part32/types/**/*.ts",
    ".next-part32/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
